#!/usr/bin/env bash
# Reads a unified diff (-U0) on stdin; exits 1 if it adds a Google API key
# literal or a secret file. Firebase client configs are allowed — they hold
# public client keys (restrict them in the Firebase/Google Cloud console).
awk '
  /^\+\+\+ b\// {
    file = substr($0, 7)
    if (file ~ /(^|\/)(\.env(\..*)?|key\.properties)$/ ||
        file ~ /\.(jks|keystore)$/ ||
        (file ~ /^env\/[^\/]*\.json$/ && file != "env/app.example.json")) {
      printf "  secret file added: %s\n", file; bad = 1
    }
    next
  }
  /^\+\+\+ / { file = ""; next }
  /^\+/ {
    if (file ~ /(google-services\.json|GoogleService-Info\.plist|firebase_options\.dart)$/) next
    if ($0 ~ /AIza[0-9A-Za-z_-]{35}/) {
      printf "  Google API key literal added in %s\n", file; bad = 1
    }
  }
  END { exit bad }
'
